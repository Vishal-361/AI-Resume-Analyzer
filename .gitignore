# Standard Python .gitignore

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Environment variables / secrets
.env

# Streamlit local secrets
.streamlit/secrets.toml

# IDE / editor files
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
